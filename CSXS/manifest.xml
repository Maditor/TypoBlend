<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="9.0" ExtensionBundleId="com.maditor.typoblend"
    ExtensionBundleVersion="1.0.0" ExtensionBundleName="TypoBlend"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.maditor.typoblend.panel" Version="1.0.0" />
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="PHXS" Version="[22.0,99.9]" />
            <Host Name="PHSP" Version="[22.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.maditor.typoblend.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./client/host.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                        <Parameter>--remote-debugging-port=8088</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>TypoBlend</Menu>
                    <Geometry>
                        <Size>
                            <Height>720</Height>
                            <Width>300</Width>
                        </Size>
                        <MinSize>
                            <Height>400</Height>
                            <Width>200</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>2400</Height>
                            <Width>500</Width>
                        </MaxSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./CSXS/icons/icon.png</Icon>
                        <Icon Type="RollOver">./CSXS/icons/icon.png</Icon>
                        <Icon Type="DarkNormal">./CSXS/icons/icon.png</Icon>
                        <Icon Type="DarkRollOver">./CSXS/icons/icon.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
